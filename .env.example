# Brainfly Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Server Port (default: 3001)
PORT=3001

# Environment: "development", "production", or "test"

# Host Binding: Default "0.0.0.0"
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated list)
# Default dev origins: http://localhost:5173,http://localhost:4173,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3001

# Production Mutation Protection
# Set to "true" to allow public editing/reset/switching in production.
# Defaults to "false" in production (read-only mode).
ALLOW_MUTATIONS=false

# Explicit Read-Only Mode (overrides development behavior when true)
READ_ONLY_MODE=false

# LLM Integration (Kilo AI Gateway)
# Set to "true" to enable LLM capabilities. Default is false (deterministic template mode).
LLM_ENABLED=false

# Comma-separated list of features to enable: chat,explain,extract
LLM_FEATURES=

# Kilo AI Gateway base URL (OpenAI-compatible)
KILO_BASE_URL=https://api.kilo.ai/api/gateway

# Optional model override (must end with :free if using free tier; must not be blocked)
KILO_MODEL=

# Comma-separated list of blocked model substrings (default: nvidia)
KILO_MODEL_BLOCKLIST=nvidia

# Optional Kilo API Key (not required for :free models)
KILO_API_KEY=

# Hourly LLM call budget (default: 150)
LLM_HOURLY_BUDGET=150
