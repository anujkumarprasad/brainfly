{
  "name": "brainfly",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun --filter '@bl/backend' dev & bun --filter '@bl/frontend' dev",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "build": "bun --filter '@bl/frontend' build",
    "clean": "rm -rf frontend/dist",
    "preview": "bun --filter '@bl/backend' dev & bun --filter '@bl/frontend' preview",
    "start": "ALLOW_MUTATIONS=true NODE_ENV=production bun backend/src/index.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "resolutions": {
    "esbuild": "^0.25.0"
  }
}
